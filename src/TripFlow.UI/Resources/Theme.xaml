<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Палітра зі згодженого макета (Figma): світло-блакитна тема -->
    <SolidColorBrush x:Key="BgBrush" Color="#EAF4FF"/>
    <SolidColorBrush x:Key="BarBrush" Color="#DCEEFC"/>
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FieldBrush" Color="#F3FAFF"/>
    <SolidColorBrush x:Key="LineBrush" Color="#D3E8FB"/>

    <SolidColorBrush x:Key="TextBrush" Color="#1E293B"/>
    <SolidColorBrush x:Key="DimBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="FaintBrush" Color="#5C6885"/>

    <SolidColorBrush x:Key="AccentBrush" Color="#2F9BEF"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#242F9BEF"/>
    <SolidColorBrush x:Key="OkBrush" Color="#16B180"/>
    <SolidColorBrush x:Key="OkSoftBrush" Color="#2416B180"/>
    <SolidColorBrush x:Key="WarnBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="WarnSoftBrush" Color="#24F59E0B"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#EF447D"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#24EF447D"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="#FFFFFF"/>

    <!-- Піктограми Windows 11 (Fluent), для Windows 10 — MDL2 -->
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
</ResourceDictionary>

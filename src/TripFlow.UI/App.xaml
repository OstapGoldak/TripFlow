<Application x:Class="TripFlow.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TripFlow.ViewModels"
             xmlns:views="clr-namespace:TripFlow.Views"
             xmlns:forms="clr-namespace:TripFlow.Views.Forms">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- ViewModel → View: екран змінюється автоматично при зміні CurrentViewModel -->
            <DataTemplate DataType="{x:Type vm:TripsOverviewViewModel}">
                <views:TripsOverviewView/>
            </DataTemplate>

            <!-- Поля форми для FormWindow -->
            <DataTemplate DataType="{x:Type vm:TripFormViewModel}">
                <forms:TripFormView/>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>

<Window x:Class="TripFlow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TripFlow — Планувальник подорожей"
        Width="1440" Height="900" MinWidth="1000" MinHeight="640"
        WindowState="Maximized" WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="14"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхня панель (макет Figma): висота 80, нижня лінія -->
        <Border Grid.Row="0" BorderBrush="{StaticResource DimBrush}" BorderThickness="0,0,0,1">
            <TextBlock Text="TripFlow" Margin="40,0" VerticalAlignment="Center"
                       FontSize="18" FontWeight="Bold"/>
        </Border>

        <!-- Поточний екран: View підбирається за типом ViewModel (див. App.xaml) -->
        <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}"/>
    </Grid>
</Window>

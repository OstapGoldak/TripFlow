<UserControl x:Class="TripFlow.Views.TripDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Кнопка-вкладка у шапці: звичайна світла, активна — синя (макет Figma) -->
        <Style x:Key="TabRadio" TargetType="RadioButton">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource DimBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root" CornerRadius="8" BorderThickness="1"
                                Background="#F5FAFF" BorderBrush="#DCEAF8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#EAF4FE"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#2D9CF0"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#2D9CF0"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка: назад, назва й дати, експорт (поруч з назвою), вкладки (справа) -->
        <Border Grid.Row="0" BorderBrush="{StaticResource DimBrush}" BorderThickness="0,0,0,1" Padding="40,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource IconButton}" Content="&#xE72B;"
                        Width="40" Height="40" VerticalAlignment="Center"
                        ToolTip="Назад до списку"
                        Command="{Binding BackCommand}"/>

                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Bold"
                               TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                    <TextBlock Text="{Binding DatesText}" Style="{StaticResource Dim}" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Експорт: PDF-звіт (принтер Windows «Microsoft Print to PDF») і JSON для перенесення -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Left"
                            VerticalAlignment="Center" Margin="32,0,0,0">
                    <Button Style="{StaticResource BoldButton}" FontWeight="Normal" Content="Експорт .pdf"
                            Height="40" Padding="16,0"
                            ToolTip="Звіт з розкладом, бюджетом і чек-листом"
                            Command="{Binding ExportPdfCommand}"/>
                    <Button Style="{StaticResource BoldButton}" FontWeight="Normal" Content="Експорт .json"
                            Height="40" Padding="16,0" Margin="8,0,0,0"
                            Command="{Binding ExportJsonCommand}"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton Style="{StaticResource TabRadio}" GroupName="TripTab" Content="Розклад"
                                 IsChecked="{Binding IsScheduleTab, Mode=TwoWay}"/>
                    <RadioButton Style="{StaticResource TabRadio}" GroupName="TripTab" Content="Бюджет"
                                 IsChecked="{Binding IsBudgetTab, Mode=TwoWay}"/>
                    <RadioButton Style="{StaticResource TabRadio}" GroupName="TripTab" Content="Чек-лист"
                                 IsChecked="{Binding IsChecklistTab, Mode=TwoWay}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Вміст вкладок. Інші модулі замінюють заглушку у своїй вкладці власним UserControl,
             наприклад: <views:ItineraryView/> у вкладці «Розклад». -->
        <Grid Grid.Row="1" Margin="40,24,40,0">
            <!-- Вкладка «Розклад»: ItineraryView підставляється через DataTemplate з App.xaml -->
            <ContentControl Content="{Binding Itinerary}"
                            Visibility="{Binding IsScheduleTab, Converter={StaticResource BoolToVis}}"/>

            <!-- Вкладка «Бюджет»: BudgetView підставляється через DataTemplate з App.xaml -->
            <ContentControl Content="{Binding Budget}"
                            Visibility="{Binding IsBudgetTab, Converter={StaticResource BoolToVis}}"/>

            <ContentControl Content="{Binding Packing}"
                Visibility="{Binding IsChecklistTab, Converter={StaticResource BoolToVis}}"/>
        </Grid>
    </Grid>
</UserControl>

<UserControl x:Class="TripFlow.Views.Forms.ActivityFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Style="{StaticResource Dim}" Margin="0,0,0,16">
            <Run Text="День:"/>
            <Run Text="{Binding DateText, Mode=OneWay}" FontWeight="SemiBold"/>
        </TextBlock>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Час" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding TimeText, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Назва" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding ActivityTitle, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </Grid>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="160"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Локація" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Орієнтовна вартість, ₴" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding CostText, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </Grid>

        <TextBlock Text="Примітка" Style="{StaticResource FieldLabel}"/>
        <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"/>
    </StackPanel>
</UserControl>
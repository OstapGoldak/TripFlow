<UserControl x:Class="TripFlow.Views.BudgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:TripFlow.Converters">
    <UserControl.Resources>
        <!-- Колір смуги: зелений, від 80% жовтий, при перевитраті червоний -->
        <conv:BudgetLevelBrushConverter x:Key="LevelBarBrush"
                                        NormalBrush="{StaticResource OkBrush}"
                                        WarningBrush="{StaticResource WarnBrush}"
                                        OverBrush="{StaticResource DangerBrush}"/>
        <!-- Колір тексту: звичайний, від 80% жовтий, при перевитраті червоний -->
        <conv:BudgetLevelBrushConverter x:Key="LevelTextBrush"
                                        NormalBrush="{StaticResource TextBrush}"
                                        WarningBrush="{StaticResource WarnBrush}"
                                        OverBrush="{StaticResource DangerBrush}"/>

        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,16,0,0"/>
        </Style>
    </UserControl.Resources>

    <!-- Уся вкладка прокручується: картки, ліміт і таблиця витрат рухаються разом -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="40,28,40,40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Три картки: заплановано, витрачено, залишок -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Height="125">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Плановий бюджет" Style="{StaticResource Dim}"/>
                    <TextBlock Text="{Binding PlannedText}" Style="{StaticResource StatValue}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Height="125">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Фактично витрачено" Style="{StaticResource Dim}"/>
                    <TextBlock Text="{Binding SpentText}" Style="{StaticResource StatValue}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource Card}" Height="125">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Залишок" Style="{StaticResource Dim}"/>
                    <TextBlock Text="{Binding RemainingText}" Style="{StaticResource StatValue}"
                               Foreground="{Binding Level, Converter={StaticResource LevelTextBrush}}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ProgressBar використання ліміту -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,20,0,0">
            <StackPanel>
                <Grid>
                    <TextBlock Text="Використано ліміту" Style="{StaticResource Dim}"/>
                    <TextBlock Text="{Binding UsedPercentText}" FontWeight="Bold" HorizontalAlignment="Right"
                               Foreground="{Binding Level, Converter={StaticResource LevelBarBrush}}"/>
                </Grid>
                <ProgressBar Margin="0,12,0,0" Minimum="0" Maximum="100"
                             Value="{Binding UsedPercent, Mode=OneWay}"
                             Foreground="{Binding Level, Converter={StaticResource LevelBarBrush}}"/>
            </StackPanel>
        </Border>

        <!-- Фільтр за категорією й кнопка додавання -->
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <ComboBox ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}"
                      DisplayMemberPath="Text" HorizontalAlignment="Left" Width="160" Height="40"/>
            <Button HorizontalAlignment="Right" Style="{StaticResource PrimaryButton}"
                    Content="+ Внести витрату" Height="40" Padding="20,0"
                    Command="{Binding AddExpenseCommand}"/>
        </Grid>

        <TextBlock Grid.Row="3" Style="{StaticResource ErrorText}" Margin="0,16,0,0"
                   Text="{Binding ErrorMessage}"
                   Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>

        <!-- Таблиця витрат -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,20,0,0" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Margin="24,0" Height="50">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Дата" FontWeight="Bold" VerticalAlignment="Center" Foreground="{StaticResource FaintBrush}"/>
                    <TextBlock Grid.Column="1" Text="Категорія" FontWeight="Bold" VerticalAlignment="Center" Foreground="{StaticResource FaintBrush}"/>
                    <TextBlock Grid.Column="2" Text="Опис" FontWeight="Bold" VerticalAlignment="Center" Foreground="{StaticResource FaintBrush}"/>
                    <TextBlock Grid.Column="3" Text="Сума" FontWeight="Bold" VerticalAlignment="Center" Foreground="{StaticResource FaintBrush}"/>
                    <TextBlock Grid.Column="4" Text="Дія" FontWeight="Bold" VerticalAlignment="Center" Foreground="{StaticResource FaintBrush}"/>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid>
                        <ItemsControl ItemsSource="{Binding Expenses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Height="76">
                                        <Grid Margin="24,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220"/>
                                                <ColumnDefinition Width="260"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="60"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding DateText}" VerticalAlignment="Center"/>

                                            <Border Grid.Column="1" Style="{StaticResource CategoryTag}" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CategoryText}" Style="{StaticResource CategoryTagText}"/>
                                            </Border>

                                            <TextBlock Grid.Column="2" Text="{Binding Description}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="3" Text="{Binding AmountText}" FontWeight="SemiBold" VerticalAlignment="Center"/>

                                            <Button Grid.Column="4" Style="{StaticResource IconButton}" Content="&#xE74D;"
                                                    Width="38" Height="38" HorizontalAlignment="Left" ToolTip="Видалити витрату"
                                                    Command="{Binding DataContext.DeleteExpenseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Витрат ще немає. Додайте першу кнопкою «+ Внести витрату»."
                                   Style="{StaticResource Dim}" HorizontalAlignment="Center" Margin="0,32,0,0"
                                   VerticalAlignment="Top"
                                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
    </ScrollViewer>
</UserControl>

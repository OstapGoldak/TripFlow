<UserControl x:Class="TripFlow.Views.TripsOverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="40,29,40,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель інструментів: ті самі 3 колонки (*,24,*,24,*), що й у сітці карток -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Фільтр за статусом -->
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <RadioButton Style="{StaticResource FilterRadio}" GroupName="TripFilter" Content="Усі"
                             IsChecked="{Binding IsAllFilter, Mode=TwoWay}"/>
                <RadioButton Style="{StaticResource FilterRadio}" GroupName="TripFilter" Content="Заплановані"
                             IsChecked="{Binding IsPlannedFilter, Mode=TwoWay}"/>
                <RadioButton Style="{StaticResource FilterRadio}" GroupName="TripFilter" Content="Завершені"
                             IsChecked="{Binding IsCompletedFilter, Mode=TwoWay}"/>
            </StackPanel>


            <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource BoldButton}" FontWeight="Normal" Content="Імпорт .json"
                        Height="40" Padding="16,0" Margin="0,0,8,0"
                        Command="{Binding ImportJsonCommand}"/>
                <Button Style="{StaticResource PrimaryButton}"
                        Content="+ Нова подорож" Height="40" Padding="20,0"
                        Command="{Binding CreateTripCommand}"/>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="1" Style="{StaticResource ErrorText}" Margin="0,16,0,0"
                   Text="{Binding ErrorMessage}"
                   Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>

        <ScrollViewer Grid.Row="2" Margin="0,30,0,0" VerticalScrollBarVisibility="Auto">
            <Grid>
                <!-- Від'ємний правий відступ: проміжок між картками 24px, а крайні картки впритул до полів.
                     VerticalAlignment=Top: картки мають свою висоту й не розтягуються на весь екран. -->
                <ItemsControl ItemsSource="{Binding Trips}" Margin="0,0,-20,0" VerticalAlignment="Top">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,20,20" VerticalAlignment="Top">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" Style="{StaticResource StatusBadge}" Margin="12,0,0,0">
                                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource StatusBadgeText}"/>
                                        </Border>
                                    </Grid>

                                    <TextBlock Text="{Binding DatesText}" Style="{StaticResource Dim}" Margin="0,16,0,0"
                                               TextTrimming="CharacterEllipsis"/>

                                    <Grid Margin="0,16,0,0">
                                        <TextBlock Text="Пакування речей" Style="{StaticResource Dim}"/>
                                        <TextBlock Text="{Binding PackingText}" Style="{StaticResource Dim}"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                    <ProgressBar Margin="0,8,0,0" Value="{Binding PackingPercent, Mode=OneWay}">
                                        <ProgressBar.Style>
                                            <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOverBudget}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ProgressBar.Style>
                                    </ProgressBar>

                                    <Grid Margin="0,16,0,0">
                                        <TextBlock Text="Бюджет"/>
                                        <TextBlock Text="{Binding BudgetText}" FontWeight="Bold" HorizontalAlignment="Right">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOverBudget}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>

                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Style="{StaticResource BoldButton}" Content="Відкрити" Height="42"
                                                Command="{Binding DataContext.OpenTripCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE70F;"
                                                ToolTip="Редагувати подорож"
                                                Width="38" Height="38" VerticalAlignment="Top"
                                                Command="{Binding DataContext.EditTripCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Grid.Column="4" Style="{StaticResource IconButton}" Content="&#xE74D;"
                                                ToolTip="Видалити подорож"
                                                Width="38" Height="38" VerticalAlignment="Top"
                                                Command="{Binding DataContext.DeleteTripCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Подорожей не знайдено. Створіть першу кнопкою «+ Нова подорож»."
                           Style="{StaticResource Dim}" HorizontalAlignment="Left" VerticalAlignment="Top"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>          
